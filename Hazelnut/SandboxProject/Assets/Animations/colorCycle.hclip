# Assets/Animations/colorCycle.hclip
AnimationClip:
  Name: colorCycle         
  Loop: true                
  TexturePath: Textures/Checkerboard.png 
  Frames:                   
    - Duration: 0.3         
      UV0: [0.0, 0.0]       
      UV1: [0.2, 1.0]       
    - Duration: 0.3
      UV0: [0.2, 0.0]
      UV1: [0.4, 1.0]
    - Duration: 0.3
      UV0: [0.4, 0.0]
      UV1: [0.6, 1.0]
    - Duration: 0.3
      UV0: [0.6, 0.0]
      UV1: [0.8, 1.0]
    - Duration: 0.3
      UV0: [0.8, 0.0]
      UV1: [1.0, 1.0]